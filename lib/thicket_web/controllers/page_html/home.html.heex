<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section class="py-16 text-center">
    <p class="mb-4 text-sm font-bold uppercase tracking-[0.3em] text-emerald-700">Welcome to</p>
    <h1 class="text-6xl font-black tracking-tight text-slate-950 sm:text-8xl">Thicket</h1>
    <p class="mx-auto mt-7 max-w-xl text-lg leading-8 text-slate-600">A place for expressive posts, small communities, and the wonderfully strange web.</p>
    <div class="mt-10 flex justify-center gap-4"><.link navigate={~p"/discover"} class="rounded-full bg-emerald-700 px-6 py-3 font-semibold text-white transition hover:bg-emerald-800">Explore the thicket</.link><.link :if={!@current_scope} navigate={~p"/users/register"} class="rounded-full border border-slate-300 px-6 py-3 font-semibold transition hover:border-emerald-700">Use an invite</.link></div>
  </section>
</Layouts.app>
